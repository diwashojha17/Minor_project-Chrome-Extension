{
  "manifest_version": 3,
  "name": "AI Web Vulnerability Scanner",
  "version": "1.0.0",
  "description": "AI-powered passive and authorized active web application security scanner with Decision Tree risk classification and interactive dashboard.",

  "permissions": [
    "activeTab",
    "storage",
    "scripting",
    "webRequest",
    "cookies",
    "tabs",
    "downloads"
  ],

  "host_permissions": [
    "http://*/*",
    "https://*/*"
  ],

  "background": {
    "service_worker": "background.js"
  },

  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },

  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}